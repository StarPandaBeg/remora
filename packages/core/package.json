{
    "name": "@remora/core",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Remora Core - API, Worker Control",
    "main": "./dist/app.js",
    "types": "./dist/app.d.ts",
    "exports": {
        ".": {
            "types": "./dist/app.d.ts",
            "import": "./dist/app.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean",
        "dev": "node --env-file-if-exists=../../.env --watch --enable-source-maps src/server.ts",
        "debug": "node --env-file-if-exists=../../.env --watch --inspect=127.0.0.1:9229 --enable-source-maps src/server.ts",
        "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.js",
        "typecheck": "tsc -b --noEmit --pretty",
        "db:push": "drizzle-kit push"
    },
    "author": "StarPanda",
    "license": "MIT",
    "dependencies": {
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@fastify/type-provider-zod": "^1.0.0",
        "drizzle-orm": "^1.0.0-rc.4",
        "fastify": "^5.12.3",
        "fastify-plugin": "^6.0.0",
        "pg": "^8.23.0",
        "zod": "^4.6.4"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^1.0.0-rc.4"
    }
}
