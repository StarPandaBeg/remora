HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Address used by the worker for callbacks; defaults to PUBLIC_BASE_URL
WORKER_CALLBACK_BASE_URL=http://127.0.0.1:3000
# Use http://remora-worker:8000 when core runs inside this Compose network
WORKER_URL=http://127.0.0.1:8000
# Milliseconds; only covers POST /tasks/execute, not task execution
WORKER_REQUEST_TIMEOUT=10000

POSTGRES_URL=postgres://remora:password@127.0.0.1:5432/remora
# Host port published by Docker Compose
POSTGRES_PORT=5432

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=remora
MINIO_SECRET_KEY=remora-development-secret
MINIO_BUCKET=remora
MINIO_REGION=us-east-1
# MinIO console port published by Docker Compose
MINIO_CONSOLE_PORT=9001

# At least 32 characters; omit to keep the worker callback disabled
WORKER_SECRET=replace-with-a-long-random-worker-secret

MAX_CONCURRENT_TASKS=2
# Worker port published by Docker Compose
WORKER_PORT=8000
HTTP_TIMEOUT=10
FINAL_EVENT_RETRY_COUNT=3
FINAL_EVENT_RETRY_BASE_DELAY=0.25

# 10 GiB
MAX_FILE_SIZE_BYTES=10737418240
