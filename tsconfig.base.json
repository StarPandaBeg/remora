{
    "compilerOptions": {
        "target": "es2025",
        "module": "nodenext",
        "sourceMap": true,
        "strict": true,
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        // project references
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "skipLibCheck": true,
        "noEmitOnError": true
    }
}
